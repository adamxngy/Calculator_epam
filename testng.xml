<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Calculator"
       parallel="classes"
       thread-count="4">

    <test name="Arithmetic Tests">

        <groups>
            <run>
                <include name="arithmetic"/>
            </run>
        </groups>

        <classes>
            <class name="com.epam.calculator.CalculatorSumTest"/>
            <class name="com.epam.calculator.CalculatorSubTest"/>
            <class name="com.epam.calculator.CalculatorMultTest"/>
            <class name="com.epam.calculator.CalculatorDivTest"/>
        </classes>

    </test>

    <test name="Comparison Tests">

        <groups>
            <run>
                <include name="comparison"/>
            </run>
        </groups>

        <classes>
            <class name="com.epam.calculator.CalculatorIsPositiveTest"/>
            <class name="com.epam.calculator.CalculatorIsNegativeTest"/>
        </classes>

    </test>

    <test name="Trigonometry Tests">

        <groups>
            <run>
                <include name="trigonometry"/>
            </run>
        </groups>

        <classes>
            <class name="com.epam.calculator.CalculatorSinTest"/>
            <class name="com.epam.calculator.CalculatorCosTest"/>
            <class name="com.epam.calculator.CalculatorTgTest"/>
            <class name="com.epam.calculator.CalculatorCtgTest"/>
        </classes>

    </test>

    <test name="Power Tests">

        <groups>
            <run>
                <include name="power"/>
            </run>
        </groups>

        <classes>
            <class name="com.epam.calculator.CalculatorPowTest"/>
            <class name="com.epam.calculator.CalculatorSqrtTest"/>
        </classes>

    </test>

</suite>